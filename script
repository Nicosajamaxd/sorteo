// --- Lógica del Algoritmo (sin cambios) ---
const gcd = (a, b) => (b === 0 ? a : gcd(b, a % b))

function intentarGenerarFixture(jugadores, cantidadPartidos) {
  if ((cantidadPartidos * 4) % jugadores.length !== 0) {
    throw new Error("Número de partidos inválido: no se puede repartir de forma justa.")
  }
  const partidosPorJugador = (cantidadPartidos * 4) / jugadores.length
  const parejas = []
  const partidosPosibles = []

  for (let i = 0; i < jugadores.length; i++) {
    for (let j = i + 1; j < jugadores.length; j++) {
      parejas.push([jugadores[i], jugadores[j]])
    }
  }

  for (let i = 0; i < parejas.length; i++) {
    for (let j = i + 1; j < parejas.length; j++) {
      const [a1, a2] = parejas[i]
      const [b1, b2] = parejas[j]
      const conjunto = new Set([a1, a2, b1, b2])
      if (conjunto.size === 4) {
        partidosPosibles.push([[a1, a2], [b1, b2]])
      }
    }
  }

  for (let i = partidosPosibles.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1))
    ;[partidosPosibles[i], partidosPosibles[j]] = [partidosPosibles[j], partidosPosibles[i]]
  }

  const partidos = []
  const contador = Object.fromEntries(jugadores.map(j => [j, 0]))
  const compañerosUsados = new Set()

  for (const partido of partidosPosibles) {
    const jugadoresEnPartido = new Set([...partido[0], ...partido[1]])
    if ([...jugadoresEnPartido].some(j => contador[j] >= partidosPorJugador)) continue
    if (compañerosUsados.has(partido[0].sort().join("-")) || compañerosUsados.has(partido[1].sort().join("-"))) continue

    partidos.push(partido)
    compañerosUsados.add(partido[0].sort().join("-"))
    compañerosUsados.add(partido[1].sort().join("-"))
    for (const j of jugadoresEnPartido) contador[j]++
    if (partidos.length === cantidadPartidos) break
  }

  if (partidos.length < cantidadPartidos) throw new Error("Fallo en la generación.")
  return { partidos, contador }
}

function generarFixture(jugadores, cantidadPartidos) {
  for (let intento = 0; intento < 50; intento++) {
    try { return intentarGenerarFixture(jugadores, cantidadPartidos) } catch (e) {}
  }
  throw new Error("No se pudo generar el fixture con estas restricciones.")
}

export default function FixtureApp() {
  const [jugadores, setJugadores] = useState(["Luis", "Ana", "Carlos", "Marta", "Pedro", "Lucía"])
  const [cantidad, setCantidad] = useState(6)
  const [error, setError] = useState(null)
  
  // Estados para persistencia
  const [fixture, setFixture] = useState(() => JSON.parse(localStorage.getItem("fixture") || "[]"))
  const [resumen, setResumen] = useState(() => JSON.parse(localStorage.getItem("resumen") || "{}"))
  const [ganadores, setGanadores] = useState(() => JSON.parse(localStorage.getItem("ganadores") || "{}"))
  
  // Estado para el modal de confirmación
  const [showConfirm, setShowConfirm] = useState(false)

  const jugadoresValidos = useMemo(() => jugadores.filter(j => j.trim() !== ""), [jugadores])
  const opcionesPartidos = useMemo(() => {
    const num = jugadoresValidos.length
    if (num < 4) return []
    const step = num / gcd(num, 4)
    return [1, 2, 3, 4, 5, 6].map(k => k * step)
  }, [jugadoresValidos.length])

  useEffect(() => {
    localStorage.setItem("fixture", JSON.stringify(fixture))
    localStorage.setItem("resumen", JSON.stringify(resumen))
    localStorage.setItem("ganadores", JSON.stringify(ganadores))
  }, [fixture, resumen, ganadores])

  const victorias = useMemo(() => {
    const conteo = {}
    Object.entries(ganadores).forEach(([idx, equipo]) => {
      const partido = fixture[idx]
      if (!partido) return
      const ganadoresArr = equipo === "A" ? partido[0] : partido[1]
      ganadoresArr.forEach(j => conteo[j] = (conteo[j] || 0) + 1)
    })
    return conteo
  }, [ganadores, fixture])

  const manejarClickGenerar = () => {
    // Si ya existe un fixture, mostrar el modal en lugar de ejecutar la función
    if (fixture.length > 0) {
      setShowConfirm(true)
    } else {
      ejecutarGeneracion()
    }
  }

  const ejecutarGeneracion = () => {
    try {
      const { partidos, contador } = generarFixture([...jugadoresValidos], cantidad)
      setFixture(partidos)
      setResumen(contador)
      setGanadores({})
      setError(null)
      setShowConfirm(false)
    } catch (err) {
      setError(err.message)
      setShowConfirm(false)
    }
  }

  return (
    <div className="p-4 space-y-6 max-w-2xl mx-auto">
      {/* ... [Código previo de Jugadores y Controles] ... */}
      
      {/* Reemplaza tu botón actual de "Generar Fixture" por este: */}
      <Button onClick={manejarClickGenerar} className="w-full sm:ml-auto">Generar Fixture</Button>

      {/* MODAL DE CONFIRMACIÓN */}
      {showConfirm && (
        <div className="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
          <Card className="max-w-sm w-full animate-in fade-in zoom-in duration-200">
            <CardContent className="p-6 space-y-4">
              <div className="flex items-center gap-2 text-amber-600">
                <AlertTriangle className="w-6 h-6" />
                <h3 className="font-bold text-lg">¿Nuevo Torneo?</h3>
              </div>
              <p className="text-sm text-gray-600">
                Ya hay un torneo en progreso. Si generas uno nuevo, perderás el progreso actual y los resultados registrados.
              </p>
              <div className="flex gap-2 pt-2">
                <Button variant="outline" className="w-full" onClick={() => setShowConfirm(false)}>Cancelar</Button>
                <Button variant="destructive" className="w-full" onClick={ejecutarGeneracion}>Sí, borrar todo</Button>
              </div>
            </CardContent>
          </Card>
        </div>
      )}

      {/* ... [Resto de tu renderizado: Partidos, Resumen, Ranking] ... */}
    </div>
  )
}
